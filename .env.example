# Database
DATABASE_URL="mysql://root:@localhost:3306/nextjs_starter"

# Auth
# Must be at least 32 characters.
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# App
NEXT_PUBLIC_APP_NAME="Next.js Starter"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NODE_ENV="development"

# Email - optional in local development.
# When empty, email sending is simulated.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NEXT_PUBLIC_FROM_EMAIL="noreply@yourdomain.com"

# Stripe - optional until billing is enabled.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENT=""

# OAuth - optional until social login is enabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Upstash Redis - optional. Empty values use the local in-memory fallback.
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3-compatible storage - optional until file storage is enabled.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STORAGE_SIGNING_SECRET="change-this-to-a-long-random-storage-secret"
NEXT_PUBLIC_STORAGE_URL=""

# Observability - optional until production monitoring is enabled.
SENTRY_DSN=""
LOG_FORMAT="pretty"
