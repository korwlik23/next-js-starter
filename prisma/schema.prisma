generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  password        String
  avatar          String?
  tenantId        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  accounts        Account[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  permissions     UserPermission[]
  roles           UserRole[]
  idempotencyKeys IdempotencyKey[]

  @@index([tenantId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([tenantId, isActive, deletedAt])
  @@map("users")
}

model Tenant {
  id            String        @id
  name          String
  slug          String        @unique
  plan          String        @default("free")
  isActive      Boolean       @default(true)
  trialEndsAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  invitations   Invitation[]
  roles         Role[]
  subscriptions Subscription?

  @@index([isActive])
  @@index([plan])
  @@index([deletedAt])
  @@map("tenants")
}

model Role {
  id          String           @id
  name        String
  description String?
  tenantId    String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  users       UserRole[]

  @@unique([name, tenantId])
  @@index([isSystem])
  @@index([tenantId], map: "roles_tenantId_fkey")
  @@map("roles")
}

model Permission {
  id          String           @id
  name        String           @unique
  description String?
  module      String
  action      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  users       UserPermission[]

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permissionId_fkey")
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  tenantId  String?
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([userId, tenantId])
  @@index([roleId], map: "user_roles_roleId_fkey")
  @@map("user_roles")
}

model UserPermission {
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId], map: "user_permissions_permissionId_fkey")
  @@map("user_permissions")
}

model RefreshToken {
  id        String    @id
  userId    String
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId], map: "refresh_tokens_userId_fkey")
  @@map("refresh_tokens")
}

model ResetPasswordToken {
  id        String   @id
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("reset_password_tokens")
}

model Account {
  id                String  @id
  userId            String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Subscription {
  id                   String    @id
  tenantId             String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("free")
  status               String    @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invitation {
  id        String   @id
  email     String
  tenantId  String
  token     String   @unique
  roleId    String
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([tenantId, status])
  @@map("invitations")
}

model Notification {
  id        String   @id
  userId    String
  title     String
  message   String
  type      String   @default("info")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isRead])
  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id
  userId    String?
  tenantId  String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?  @db.LongText
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

model ApiKey {
  id         String    @id
  tenantId   String
  name       String
  hashedKey  String    @unique
  prefix     String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([tenantId, isActive])
  @@map("api_keys")
}

model Translation {
  id        String   @id
  locale    String
  namespace String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@index([locale])
  @@map("translations")
}

model FeatureFlag {
  id          String   @id
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model IdempotencyKey {
  key         String   @id
  userId      String?
  requestHash String   @db.Text
  response    String?  @db.LongText
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model TenantMembership {
  id        String    @id
  tenantId  String
  userId    String
  roleId    String?
  status    String    @default("active")
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("tenant_memberships")
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model WebhookEvent {
  id          String    @id
  provider    String
  eventId     String
  eventType   String
  payload     Json?
  status      String    @default("pending")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_events")
}

model UploadedFile {
  id         String    @id
  tenantId   String?
  userId     String?
  name       String
  mimeType   String
  size       Int
  disk       String    @default("local")
  visibility String    @default("public")
  storageKey String
  url        String?
  checksum   String?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([userId])
  @@index([disk])
  @@index([visibility])
  @@index([storageKey])
  @@index([deletedAt])
  @@map("uploaded_files")
}

model EmailLog {
  id        String    @id
  tenantId  String?
  userId    String?
  to        String
  subject   String
  template  String?
  status    String    @default("queued")
  provider  String?
  messageId String?
  error     String?   @db.Text
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

model ImpersonationSession {
  id           String    @id
  actorUserId  String
  targetUserId String
  reason       String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("impersonation_sessions")
}
